{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.@(js|css|svg|jpg|jpeg|png|webp|mp4)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
